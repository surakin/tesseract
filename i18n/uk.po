msgstr "Парольні фрази відновлення не збігаються."

#: ui/shared/views/EncryptionSetupOverlay.cpp:1306
msgid "Enter your recovery key"
msgstr "Введіть ключ відновлення"

#: ui/shared/views/EncryptionSetupOverlay.cpp:1307
