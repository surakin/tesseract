<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by CMake (cmake/Msix.cmake) from Tesseract.appinstaller.in.
  Direct-distribution edition only — Store installs are updated by the
  Microsoft Store, not App Installer.

  Points at stable GitHub Releases "latest" URLs so re-publishing a new
  tagged release is enough to make App Installer offer the update; nothing
  here needs to change per-release.
-->
<AppInstaller
    xmlns="http://schemas.microsoft.com/appx/appinstaller/2018"
    Uri="@TESSERACT_MSIX_UPDATE_URI@/Tesseract-x64.appinstaller"
    Version="@TESSERACT_MSIX_VERSION@">

  <MainPackage
      Name="@TESSERACT_MSIX_DIRECT_IDENTITY_NAME@"
      Publisher="@TESSERACT_MSIX_PUBLISHER@"
      Version="@TESSERACT_MSIX_VERSION@"
      Uri="@TESSERACT_MSIX_UPDATE_URI@/Tesseract-direct-x64.msix"
      ProcessorArchitecture="x64" />

  <UpdateSettings>
    <!-- Check on every launch, at most every 12h; never block activation or
         prompt the user, and never silently downgrade (the default absent
         ForceUpdateFromAnyVersion). -->
    <OnLaunch HoursBetweenUpdateChecks="12" ShowPrompt="false" UpdateBlocksActivation="false" />
  </UpdateSettings>
</AppInstaller>
