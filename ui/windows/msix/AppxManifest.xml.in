<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by CMake (cmake/Msix.cmake) from AppxManifest.xml.in — do not
  edit the staged copy directly, edit this template instead.

  Two editions are produced from this one template with different
  substituted values: the Microsoft Store edition and the direct-
  distribution edition. They intentionally use distinct Identity/@Name and
  Identity/@Publisher values (see cmake/Msix.cmake) so the two can be
  installed side by side; the shared single-instance mutex still prevents
  running both at once.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap desktop rescap">

  <Identity
      Name="@TESSERACT_MSIX_IDENTITY_NAME@"
      Publisher="@TESSERACT_MSIX_PUBLISHER@"
      Version="@TESSERACT_MSIX_VERSION@"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Tesseract</DisplayName>
    <PublisherDisplayName>@TESSERACT_MSIX_PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Tesseract — cross-platform Matrix chat client</Description>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <!-- 10.0.18362.0 = Windows 10 version 1903, the plan's minimum target. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
    <DeviceCapability Name="microphone" />
    <DeviceCapability Name="webcam" />
  </Capabilities>

  <Applications>
    <Application Id="Tesseract" Executable="Tesseract.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Tesseract"
          Description="Tesseract — cross-platform Matrix chat client"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png"
          BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Forwards matrix: URIs to Tesseract.exe's existing command-line
             parser (see ui/windows/src/main.cpp) — packaged installs rely on
             this declaration instead of the HKCU registry registration the
             unpackaged/NSIS build writes at first launch. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="matrix">
            <uap:DisplayName>Tesseract</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- TaskId matches the WinRT StartupTask id Win32Autostart.cpp already
             queries/enables via Windows.ApplicationModel.StartupTask. -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask
              TaskId="TesseractStartup"
              Enabled="false"
              DisplayName="Tesseract" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
