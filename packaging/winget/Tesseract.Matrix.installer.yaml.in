# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.12.0.schema.json
# Generated by CMake from Tesseract.Matrix.installer.yaml.in — edit that
# file, not this one.
#
# Reference copy only — see Tesseract.Matrix.yaml for details.
#
# Points at the NSIS .exe from cmake/Installers.cmake, uploaded to the
# GitHub Release created by .github/workflows/package.yml on a `v*` tag
# push. The MSIX editions are not submitted here: the Store edition already
# distributes through the Microsoft Store itself, and the direct MSIX edition's
# publisher identity isn't a real, permanently-signed certificate yet (see
# PACKAGING.md's MSIX section) — winget's own MSIX validation pins the
# package's signing certificate thumbprint, so switching signing certs later
# would break existing installs.
#
# InstallerSha256 is never real here — it's recomputed from the actual
# release asset by `wingetcreate` at submission time (see
# packaging/winget/README.md). It's left as a placeholder purely so this
# file stays valid YAML to eyeball.
PackageIdentifier: Tesseract.Matrix
PackageVersion: @PROJECT_VERSION@
InstallerType: nullsoft
Scope: machine
ElevationRequirement: elevatesSelf
InstallModes:
  - interactive
  - silent
  - silentWithProgress
InstallerSwitches:
  Silent: /S
  SilentWithProgress: /S
UpgradeBehavior: install
Installers:
  - Architecture: x64
    InstallerUrl: https://github.com/surakin/tesseract/releases/download/v@PROJECT_VERSION@/Tesseract-@PROJECT_VERSION@-AMD64.exe
    InstallerSha256: PLACEHOLDER_SHA256_COMPUTE_FROM_RELEASE_ASSET
ManifestType: installer
ManifestVersion: 1.12.0
