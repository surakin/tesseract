<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.surakin.Tesseract</id>
  <name>Tesseract</name>
  <summary>Matrix chat client</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.surakin">
    <name>Marco Antonio Alvarez</name>
  </developer>
  <url type="homepage">https://github.com/surakin/tesseract</url>
  <url type="bugtracker">https://github.com/surakin/tesseract/issues</url>
  <description>
    <p>
      Tesseract is a full-featured, native desktop Matrix client built on the
      Matrix Rust SDK. It supports end-to-end encryption, voice messages,
      custom emoji and sticker packs, replies, message editing, reactions,
      threads, spaces, multiple accounts, and native voice/video calls
      (MatrixRTC).
    </p>
    <p>
      Tesseract only works with homeservers running Sliding Sync. The
      preferred login method is the Matrix Authentication Service (MAS) /
      OAuth2; homeservers without MAS can fall back to plain
      username/password login for existing accounts.
    </p>
  </description>
  <launchable type="desktop-id">io.github.surakin.Tesseract.desktop</launchable>
